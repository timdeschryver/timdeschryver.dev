{
	"name": "timdeschryver.dev",
	"version": "0.0.1",
	"description": "timdeschryver.dev",
	"license": "MIT",
	"author": "Tim Deschryver",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "pnpm generate:themes && rimraf build && pnpm copy:content",
		"build": "vite build",
		"preview": "vite preview",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:unit": "vitest",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxfmt --list-different . && oxlint --format=agent .",
		"format": "oxfmt .",
		"copy:content": "pnpm copy:blog && pnpm copy:bits",
		"copy:blog": "cpy 'blog/**/*.*' '!blog/**/*.md' 'static/blog'",
		"copy:bits": "cpy 'bits/**/*.*' '!bits/**/*.md' 'static/bits'",
		"g": "node ./scripts/generate",
		"gb": "node ./scripts/generate-bit",
		"p": "node ./scripts/devto",
		"banners": "node ./scripts/banners.js",
		"pre-commit": "pnpm banners && git add ./**/banner.png && lint-staged",
		"optimize:image": "node ./scripts/optimize-image-cli.js",
		"optimize:images": "node ./scripts/optimize-images.js",
		"contributors": "node ./scripts/contributors.js",
		"generate:themes": "node ./scripts/generate-syntax-themes.js",
		"postinstall": "svelte-kit sync",
		"prepare": "git config core.hookspath .githooks"
	},
	"devDependencies": {
		"@azure/identity": "^4.13.1",
		"@azure/playwright": "^1.1.6",
		"@azure/static-web-apps-cli": "^2.0.10",
		"@fontsource-variable/hubot-sans": "^5.3.0",
		"@fontsource-variable/mona-sans": "^5.3.0",
		"@fontsource-variable/victor-mono": "^5.3.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@testing-library/svelte": "5.4.2",
		"@types/canvas-confetti": "1.9.0",
		"@types/marked": "6.0.0",
		"@types/node": "^24.13.3",
		"axe-playwright": "2.2.2",
		"canvas-confetti": "1.9.4",
		"cpy-cli": "7.0.0",
		"dotenv": "^17.4.2",
		"dotenv-extended": "3.1.0",
		"front-matter": "4.0.2",
		"jsdom": "30.0.1",
		"lint-staged": "17.3.0",
		"marked": "18.0.7",
		"node-fetch": "3.3.2",
		"oxfmt": "^0.61.0",
		"oxlint": "^1.76.0",
		"playwright": "1.62.1",
		"rimraf": "6.1.3",
		"sharp": "^0.35.3",
		"shiki": "4.4.1",
		"svelte": "5.56.8",
		"svelte-check": "4.7.4",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"vite": "8.2.0",
		"vite-plugin-restart": "2.0.0",
		"vite-svg-loader": "5.1.1",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": "^24.0.0"
	},
	"packageManager": "pnpm@10.34.4"
}
